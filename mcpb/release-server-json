#!/bin/sh
# Fills server.json in place for release TAG: the version, the bundle's download URL and its SHA-256.
# Used by the release workflow before publishing, and by CI to validate what a release would publish.
# Usage: mcpb/release-server-json TAG BUNDLE
set -eu
tag=$1
sha=$(sha256sum "$2" | cut -d' ' -f1)
jq --arg v "${tag#v}" --arg t "$tag" --arg sha "$sha" \
  '.version = $v
   | .packages[0].identifier = "https://github.com/compscidr/sair/releases/download/\($t)/sair-mcp.mcpb"
   | .packages[0].fileSha256 = $sha' server.json > server.json.tmp
mv server.json.tmp server.json
